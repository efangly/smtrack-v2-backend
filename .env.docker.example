# ค่า env ที่ docker-compose.yml ใช้กับ service `app` และ `migrate`
# ไฟล์นี้ไว้อ้างอิงเฉย ๆ — compose ตั้งค่าเหล่านี้ให้ในตัวอยู่แล้ว (ดู x-app-env)
# ถ้าจะรัน app บน host แต่ชี้ไป stack ใน docker ให้ copy เป็น .env แล้วแก้ hostname เป็น localhost

DATABASE_URL=postgresql://postgres:postgres@timescaledb:5432/smtrack
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_CLIENT_ID=nestjs-iot-service
MQTT_LOG_TOPIC=devices/+/log
MQTT_NOTIFICATION_TOPIC_PREFIX=notification
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_DEVICE_ONLINE_QUEUE=device_online_queue
RABBITMQ_LOG_QUEUE=log_queue
RABBITMQ_FCM_QUEUE=fcm_notification_queue

JWT_SECRET=local-dev-secret-not-for-production
DEVICE_SECRET=local-dev-device-secret-not-for-production

ARCHIVE_RETENTION_MONTHS=6

# Archive object storage — MinIO ใน compose (S3-compatible)
# FORCE_PATH_STYLE ต้องเป็น true กับ MinIO เพราะไม่รองรับ virtual-host style bucket
ARCHIVE_S3_ENDPOINT=http://minio:9000
ARCHIVE_S3_ACCESS_KEY=minioadmin
ARCHIVE_S3_SECRET_KEY=minioadmin
ARCHIVE_S3_BUCKET=smtrack-log-archive
ARCHIVE_S3_FORCE_PATH_STYLE=true
ARCHIVE_S3_REGION=us-east-1

# Device image upload (positionPic) — MinIO ตัวเดียวกับ archive ใน compose, ต่างกันแค่ bucket
# (ไม่ต้องตั้ง endpoint/credentials ซ้ำ จะ fallback ไปใช้ ARCHIVE_S3_* ให้อัตโนมัติ)
DEVICE_S3_BUCKET=smtrack-device-images

PORT=3000

# Observability — ชี้ไป Collector ในเครือข่าย compose
# NODE_ENV=production สำคัญ: logger.config.ts จะพ่น JSON ออก stdout ให้ Alloy เก็บ
# (ถ้าเป็น development จะใช้ pino-pretty ซึ่ง Alloy parse เป็น JSON ไม่ได้)
NODE_ENV=production
LOG_LEVEL=debug
OTEL_SERVICE_NAME=smtrack-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
