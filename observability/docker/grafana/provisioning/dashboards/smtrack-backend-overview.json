{
  "uid": "smtrack-backend-overview",
  "title": "SMtrack Backend - ภาพรวมระบบ",
  "tags": ["smtrack", "backend"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "อัตราคำขอ HTTP",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_server_duration_milliseconds_count[$__rate_interval])) by (http_route, http_status_code)",
          "legendFormat": "{{http_route}} [{{http_status_code}}]"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "ระยะเวลาตอบสนอง HTTP (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_duration_milliseconds_bucket[$__rate_interval])) by (le, http_route))",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "ระยะเวลาคำสั่งฐานข้อมูล PostgreSQL (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(db_client_operation_duration_seconds_bucket[$__rate_interval])) by (le, db_operation_name))",
          "legendFormat": "{{db_operation_name}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "ระยะเวลาบันทึก Telemetry (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(smtrack_telemetry_ingest_duration_milliseconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "อัตราข้อความ MQTT",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(smtrack_mqtt_messages_total[$__rate_interval])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "อัตราข้อความ RabbitMQ",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(smtrack_rmq_messages_total[$__rate_interval])) by (queue, status)",
          "legendFormat": "{{queue}} [{{status}}]"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "อัตราการส่งแจ้งเตือน",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(smtrack_notification_delivery_total[$__rate_interval])) by (channel, status)",
          "legendFormat": "{{channel}} [{{status}}]"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "จำนวนการเชื่อมต่อ SSE ที่ใช้งานอยู่",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(smtrack_sse_active_connections)",
          "legendFormat": "SSE"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "หน่วยความจำ V8 Heap ที่ใช้งาน",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(v8js_memory_heap_used_bytes{job=\"smtrack-backend\"}) by (v8js_heap_space_name)",
          "legendFormat": "{{v8js_heap_space_name}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "ความหน่วง Event Loop (p99)",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nodejs_eventloop_delay_p99_seconds{job=\"smtrack-backend\"}",
          "legendFormat": "p99"
        }
      ]
    }
  ]
}
