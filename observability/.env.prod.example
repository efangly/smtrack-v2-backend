# ค่า env ที่ docker-compose.yml ใช้ — สำหรับ deploy observability stack เดี่ยว ๆ บน prod server
# ที่มี mosquitto/minio/app รันอยู่แล้ว (คนละ compose) เหมือนกับ .env.example (dev) ทุกอย่าง
# ต่างกันแค่ค่าจริงที่ต้องชี้ไปยัง MinIO/network ของ prod แทน dev
#
#   cp observability/.env.prod.example observability/.env.prod   # แล้วแก้ค่าให้เป็นของจริงก่อน deploy

# docker network ภายนอกที่ mosquitto/minio/app ใช้อยู่บน prod server
# (compose นี้ไม่สร้าง network เอง ต้องมี network นี้อยู่ก่อนแล้วเสมอ)
EXTERNAL_NETWORK=proxy

# Grafana เข้าถึงได้จากภายนอก (ต่างจาก local stack ที่เปิด anonymous admin) — ตั้งรหัสผ่านให้แน่นหนา
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme-strong-password

# Tempo/Loki เก็บ trace/log ลง MinIO ที่มีอยู่แล้วบน prod server (ไม่ใช้ local disk)
# host:port ล้วน ไม่มี scheme — ต้องอยู่บน network เดียวกับ EXTERNAL_NETWORK ข้างบน
MINIO_ENDPOINT=minio:9000

# credential สำหรับ job สร้าง bucket (object-storage-init) เท่านั้น — ต้องเป็น root/admin
# ของ MinIO เพราะต้องมีสิทธิ์ s3:CreateBucket ซึ่ง user แบบ scoped ต่อ bucket (ด้านล่าง) ไม่มี
# reuse credential เดียวกับที่ app ใช้ export archive (ARCHIVE_S3_ACCESS_KEY/SECRET_KEY ใน .env ของ app บน prod)
ARCHIVE_S3_ACCESS_KEY=
ARCHIVE_S3_SECRET_KEY=
TEMPO_S3_BUCKET=tempo-traces
LOKI_S3_BUCKET=loki-chunks

# credential ที่ Tempo ใช้เขียน/อ่าน trace จริง — user แยกต่างหาก scope เฉพาะ bucket
# tempo-traces เท่านั้น (ไม่ใช้ ARCHIVE_S3_* ร่วมกับ archive/device/firmware/loki อีกต่อไป)
# สร้าง user นี้ได้ด้วย scripts/minio-setup.sh (ที่ repo หลัก) แล้ว copy access key/secret key
# ของ bucket 'tempo-traces' มาใส่ตรงนี้
TEMPO_S3_ACCESS_KEY=
TEMPO_S3_SECRET_KEY=
TEMPO_S3_REGION=us-east-1

# credential ที่ Loki ใช้เขียน/อ่าน log chunk จริง — user แยกต่างหาก scope เฉพาะ bucket
# loki-chunks เท่านั้น สร้างด้วย scripts/minio-setup.sh เหมือนกัน (bucket 'loki-chunks')
LOKI_S3_ACCESS_KEY=
LOKI_S3_SECRET_KEY=
LOKI_S3_REGION=us-east-1

# Alertmanager → Telegram — สร้าง bot ผ่าน @BotFather แล้วหา chat_id ของกลุ่ม/ผู้ใช้ที่จะรับแจ้งเตือน
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
