# ค่า env ที่ docker-compose.observability.yml ใช้ — สำหรับ deploy observability stack
# เดี่ยว ๆ บน dev server ที่มี mosquitto/minio/app รันอยู่แล้ว (คนละ compose)
#
#   cp .env.observability.example .env.observability   # แล้วแก้ค่าให้เป็นของจริงก่อน deploy

# docker network ภายนอกที่ mosquitto/minio/app ใช้อยู่บน dev server
# (compose นี้ไม่สร้าง network เอง ต้องมี network นี้อยู่ก่อนแล้วเสมอ)
EXTERNAL_NETWORK=proxy

# Grafana เข้าถึงได้จากภายนอก (ต่างจาก local stack ที่เปิด anonymous admin) — ตั้งรหัสผ่านให้แน่นหนา
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme-strong-password

# Tempo/Loki เก็บ trace/log ลง MinIO เดิมที่มีอยู่แล้วบน dev server (ไม่ใช้ local disk)
# host:port ล้วน ไม่มี scheme — ต้องอยู่บน network เดียวกับ EXTERNAL_NETWORK ข้างบน
MINIO_ENDPOINT=minio:9000
# reuse credential เดียวกับที่ app ใช้ export archive (ARCHIVE_S3_ACCESS_KEY/SECRET_KEY ใน .env ของ app)
ARCHIVE_S3_ACCESS_KEY=
ARCHIVE_S3_SECRET_KEY=
ARCHIVE_S3_REGION=us-east-1
TEMPO_S3_BUCKET=tempo-traces
LOKI_S3_BUCKET=loki-chunks

# Alertmanager → Telegram — สร้าง bot ผ่าน @BotFather แล้วหา chat_id ของกลุ่ม/ผู้ใช้ที่จะรับแจ้งเตือน
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
