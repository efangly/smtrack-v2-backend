# PostgreSQL + TimescaleDB (extension enabled in the same database)
DATABASE_URL=postgresql://postgres:postgres@demo.siamatic.co.th:5444/smtrack

# MQTT broker
MQTT_BROKER_URL=mqtt://siamatic.thddns.net:1883
MQTT_USERNAME=admin
MQTT_PASSWORD=admin
MQTT_CLIENT_ID=nestjs-iot-service
MQTT_LOG_TOPIC=devices/+/log
MQTT_NOTIFICATION_TOPIC_PREFIX=notification

# Redis
REDIS_URL=redis://45.136.237.142:6379

# RabbitMQ
RABBITMQ_URL=amqp://admin:thanesmail1234@45.136.237.142:5672
RABBITMQ_DEVICE_ONLINE_QUEUE=device_online_queue
RABBITMQ_LOG_QUEUE=log_queue

# Auth
JWT_SECRET=Jpc3MiOiJmdXNpb25hdXRoLmlvIiwiZXhwIjoxNTkwNzA4Mzg1LCJhdW
DEVICE_SECRET=local-dev-device-secret-not-for-production

# Firebase Cloud Messaging (service account)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# LogDays archive (export to object storage before TimescaleDB retention drops the chunk)
ARCHIVE_RETENTION_MONTHS=6
# MinIO (self-hosted); leave ARCHIVE_S3_ENDPOINT empty + FORCE_PATH_STYLE=false to use AWS S3 instead
ARCHIVE_S3_ENDPOINT=http://192.168.0.245:9000
ARCHIVE_S3_ACCESS_KEY=smtrack-log-archive
ARCHIVE_S3_SECRET_KEY=Jpc3MiOiJmdXNpb25hdXRoLmlvIiwiZXhwIjoxNTkwNzA4Mzg1LCJhdW
ARCHIVE_S3_BUCKET=smtrack-log-archive
ARCHIVE_S3_FORCE_PATH_STYLE=true
ARCHIVE_S3_REGION=us-east-1

# Device image upload (positionPic) — object storage เดียวกับ MinIO ของ archive แต่คนละ bucket
# ถ้าเป็น MinIO/S3 ตัวเดียวกัน (endpoint/credentials/region เหมือนกัน) ตั้งแค่ DEVICE_S3_BUCKET ก็พอ
# ที่เหลือจะ fallback ไปใช้ค่า ARCHIVE_S3_* ให้อัตโนมัติ — ตั้ง DEVICE_S3_ENDPOINT/ACCESS_KEY/SECRET_KEY/etc
# แยกเฉพาะกรณีใช้คนละ storage/credentials จริง ๆ
DEVICE_S3_BUCKET=smtrack-device-images
# DEVICE_S3_ENDPOINT=http://192.168.0.245:9000
# DEVICE_S3_ACCESS_KEY=smtrack-device-images
# DEVICE_S3_SECRET_KEY=Jpc3MiOiJmdXNpb25hdXRoLmlvIiwiZXhwIjoxNTkwNzA4Mzg1LCJhdW
# DEVICE_S3_FORCE_PATH_STYLE=true
# DEVICE_S3_REGION=us-east-1

# HTTP
PORT=3000
# comma-separated origin list ที่อนุญาตให้ frontend เรียก API/SSE ได้ (CORS); ปล่อยว่าง = เปิดรับทุก origin
CORS_ORIGIN=http://localhost:3001

# Observability
# production = JSON log ออก stdout ให้ Alloy เก็บไป Loki; ค่าอื่น = pino-pretty
NODE_ENV=development
LOG_LEVEL=info
OTEL_SERVICE_NAME=smtrack-backend
# ปล่อยว่าง = ปิด OTel SDK ทั้งหมด (รันได้โดยไม่ต้องมี Collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
