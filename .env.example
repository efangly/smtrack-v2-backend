# PostgreSQL + TimescaleDB (extension enabled in the same database)
DATABASE_URL=
# DB ของ auth-service — ใช้เฉพาะ scripts/backfill-tenant (อ่าน departments.id → tenant_id)
AUTH_DATABASE_URL=

# MQTT broker
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=
# ต่อท้ายด้วย MQTT_INSTANCE_ID หรือ HOSTNAME อัตโนมัติ (ไม่ซ้ำข้าม replica)
MQTT_INSTANCE_ID=
# shared subscription group ของ devices/+/log (ว่าง = smtrack-ingest, none = ปิด)
MQTT_SHARED_GROUP=
MQTT_CLEAN_SESSION=
MQTT_LOG_TOPIC=
# topic realtime ~5s (ไม่บันทึก DB) — ใช้แค่ push อุณหภูมิสดตอนปรับค่าชดเชย ยังไม่ได้ตกลง topic จริงกับฝั่ง firmware, กรอกค่าจริงตรงนี้
MQTT_REALTIME_TOPIC=
MQTT_NOTIFICATION_TOPIC_PREFIX=

# Redis
REDIS_URL=

# RabbitMQ
RABBITMQ_URL=
RABBITMQ_DEVICE_ONLINE_QUEUE=device_online_queue
RABBITMQ_LOG_QUEUE=log_queue
RABBITMQ_FCM_QUEUE=fcm_notification_queue
# Legacy sync (ADR-0007) — ระบบเดิม publish เข้า exchange นี้ ชั่วคราวจนถึง cutover
LEGACY_SYNC_ENABLED=
RABBITMQ_LEGACY_EXCHANGE=
RABBITMQ_LEGACY_SYNC_QUEUE=
RABBITMQ_LEGACY_SYNC_DLQ=

# Auth
JWT_SECRET=
DEVICE_SECRET=

# Partner API (third-party) — gRPC listen address, X-API-Key ตรวจใน DB ไม่ใช่ env
GRPC_URL=0.0.0.0:50051

# Archive (monthly export of log_days/notifications/device_audit/user_audit to object storage
# before the chunk leaves the hot window — see docs/archive-operations.md). Used by the API and
# by the archive CronJob (node dist/cli/archive-job). Hot window length is fixed in code, not env.
# MinIO (self-hosted); leave ARCHIVE_S3_ENDPOINT empty + FORCE_PATH_STYLE=false to use AWS S3 instead
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_ACCESS_KEY=
ARCHIVE_S3_SECRET_KEY=
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_FORCE_PATH_STYLE=true
ARCHIVE_S3_REGION=us-east-1

# Device image upload (positionPic) — object storage เดียวกับ MinIO ของ archive แต่คนละ bucket
# ถ้าเป็น MinIO/S3 ตัวเดียวกัน (endpoint/credentials/region เหมือนกัน) ตั้งแค่ DEVICE_S3_BUCKET ก็พอ
# ที่เหลือจะ fallback ไปใช้ค่า ARCHIVE_S3_* ให้อัตโนมัติ — ตั้ง DEVICE_S3_ENDPOINT/ACCESS_KEY/SECRET_KEY/etc
# แยกเฉพาะกรณีใช้คนละ storage/credentials จริง ๆ
DEVICE_S3_BUCKET=
# DEVICE_S3_ENDPOINT=
# DEVICE_S3_ACCESS_KEY=
# DEVICE_S3_SECRET_KEY=
# DEVICE_S3_FORCE_PATH_STYLE=true
# DEVICE_S3_REGION=us-east-1

# Firmware file upload (OTA) — object storage เดียวกับ MinIO ของ archive แต่คนละ bucket
# ถ้าเป็น MinIO/S3 ตัวเดียวกัน (endpoint/credentials/region เหมือนกัน) ตั้งแค่ FIRMWARE_S3_BUCKET ก็พอ
# ที่เหลือจะ fallback ไปใช้ค่า ARCHIVE_S3_* ให้อัตโนมัติ — ตั้ง FIRMWARE_S3_ENDPOINT/ACCESS_KEY/SECRET_KEY/etc
# แยกเฉพาะกรณีใช้คนละ storage/credentials จริง ๆ
FIRMWARE_S3_BUCKET=
# FIRMWARE_S3_ENDPOINT=
# FIRMWARE_S3_ACCESS_KEY=
# FIRMWARE_S3_SECRET_KEY=
# FIRMWARE_S3_FORCE_PATH_STYLE=true
# FIRMWARE_S3_REGION=us-east-1
# max upload size ต่อไฟล์ firmware (bytes) — default 100MB
FIRMWARE_MAX_FILE_SIZE=104857600

# Legacy MongoDB backup (efangly/smtrack-backup) — only needed for
# scripts/migrate-legacy/migrate-legacy-backup.ts, not app runtime
MONGO_BACKUP_URL=

# Legacy firmware drive (drive.siamatic.co.th) — only needed for
# scripts/migrate-legacy/migrate-firmware.ts, not app runtime
DRIVE_API_URL=
DRIVE_API_TOKEN=

# HTTP
PORT=3000
# comma-separated origin list ที่อนุญาตให้ frontend เรียก API/SSE ได้ (CORS); ปล่อยว่าง = เปิดรับทุก origin
CORS_ORIGIN=

# Observability
# production = JSON log ออก stdout ให้ Alloy เก็บไป Loki; ค่าอื่น = pino-pretty
NODE_ENV=development
LOG_LEVEL=info
OTEL_SERVICE_NAME=smtrack-backend
# ปล่อยว่าง = ปิด OTel SDK ทั้งหมด (รันได้โดยไม่ต้องมี Collector)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Alertmanager → Telegram (docker-compose.yml service `alertmanager`)
# สร้าง bot ผ่าน @BotFather แล้วหา chat_id ของกลุ่ม/ผู้ใช้ที่จะรับแจ้งเตือน
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
