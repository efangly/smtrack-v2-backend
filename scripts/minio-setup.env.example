# ค่า env ที่ scripts/minio-setup.sh ใช้ได้ — สคริปต์สร้าง bucket + user/policy แยกต่อ bucket
# บน MinIO (local dev หรือ instance จริงบน dev server ก็ได้)
#
#   cp scripts/minio-setup.env.example scripts/minio-setup.env   # แก้ค่าให้ตรง instance ที่จะรัน
#   set -a && source scripts/minio-setup.env && set +a && ./scripts/minio-setup.sh
#
# ห้าม commit ไฟล์ scripts/minio-setup.env ตัวจริง (มี root password) — .gitignore กัน *.out.env
# ไว้แล้ว แต่ถ้า copy ไฟล์นี้เป็นชื่ออื่นที่ไม่ตรง pattern ให้เพิ่มลง .gitignore เองด้วย

# endpoint ของ MinIO ที่จะสร้าง bucket ให้ (local docker-compose = localhost:9000,
# dev server จริงดูค่าใน .env → ARCHIVE_S3_ENDPOINT)
MINIO_ENDPOINT=http://localhost:9000

# root credential ของ MinIO instance นั้น — ถ้าปล่อยว่างสคริปต์จะ prompt ให้กรอกเองตอนรัน
# (แนะนำให้ปล่อยว่างไว้ ไม่ต้องตั้งในไฟล์นี้ กัน root password หลุดค้างในไฟล์/shell history)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# รายชื่อ bucket ที่จะสร้าง (คั่นด้วยช่องว่าง) — ปล่อยว่างเพื่อใช้ default 5 ตัวของโปรเจค
# (smtrack-log-archive smtrack-device-images smtrack-firmware tempo-traces loki-chunks)
BUCKETS=

# ไฟล์ที่จะบันทึก access key/secret key ที่ generate ใหม่ (secret ห้าม commit)
OUT_FILE=scripts/minio-setup.out.env
