generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// จุดติดตั้งเชิงตรรกะ (logical unit) — เช่น "ตู้เย็น ICU เตียง 3" ไม่ใช่กล่องฮาร์ดแวร์
///
/// `staticName` คือ identity ถาวรของจุดติดตั้ง ส่วน `serial` เป็นเพียง pointer ไปยังกล่องที่
/// "ติดตั้งอยู่ ณ ตอนนี้" (denormalized มาจาก assignment ที่ endedAt IS NULL) — เมื่อสลับเครื่อง
/// ค่านี้เปลี่ยน แต่ config/probe/ประวัติ telemetry ยังผูกกับ Devices.id เดิมจึงอยู่ครบ
///
/// ห้ามเขียน `serial` ตรง ๆ จากที่อื่น ให้ผ่าน DeviceSwapService เท่านั้น
/// เพื่อให้ assignment กับ pointer ตรงกันเสมอ
model Devices {
  id           String              @id @default(uuid()) @map("id")
  serial       String?             @unique @map("serial")
  staticName   String              @unique @map("static_name")
  /// tenant ใน auth-service ที่จุดติดตั้งนี้สังกัด — ขอบเขตหลักของการเห็นข้อมูล
  /// null = ยังไม่ backfill (scripts/backfill-tenant) เห็นได้เฉพาะ SUPER/SERVICE ดู docs/adr/0004-device-tenant-scope.md
  tenantId     String?             @map("tenant_id")
  /// department ใน auth-service (คือ ID ward เดิม) — แบ่งย่อยภายใน tenant
  departmentId String              @default("WID-DEVELOPMENT") @map("department_id")
  name         String?             @map("name")
  status       Boolean             @default(false) @map("status")
  seq          Int                 @map("seq")
  location     String?             @map("location")
  position     String?             @map("position")
  positionPic  String?             @map("position_pic")
  remark       String?             @map("remark")
  online       Boolean             @default(false) @map("online")
  tag          String?             @map("tag")
  hardware     Hardware?           @relation("CurrentHardware", fields: [serial], references: [serial], onDelete: SetNull)
  assignments  DeviceAssignments[]
  config       Configs?
  probe        Probes[]
  log          LogDays[]
  notification Notifications[]
  createAt     DateTime            @default(now()) @map("create_at")
  updateAt     DateTime            @default(now()) @updatedAt @map("update_at")

  @@index([tenantId, departmentId])
  @@map("devices")
}

/// กล่องฮาร์ดแวร์จริง — `serial` คือเลขเครื่องที่อุปกรณ์รายงานตัวเองผ่าน MQTT/JWT
/// ถืออะไรก็ตามที่เดินตามกล่องไป: firmware, token, ประวัติซ่อม, ประกัน
/// กล่องที่ถูกถอดออกมาซ่อมแล้วนำไปติดตั้งที่จุดอื่นยังเป็นแถวเดิมนี้ (ประวัติจึงตามไปด้วย)
model Hardware {
  id            String              @id @default(uuid()) @map("id")
  serial        String              @unique @map("serial")
  firmware      String              @default("1.0.0") @map("firmware")
  token         String?             @map("token")
  installDate   DateTime?           @default(now()) @map("install_date")
  currentDevice Devices?            @relation("CurrentHardware")
  assignments   DeviceAssignments[]
  repair        Repairs[]
  warranty      Warranties[]
  log           LogDays[]
  notification  Notifications[]
  createAt      DateTime            @default(now()) @map("create_at")
  updateAt      DateTime            @default(now()) @updatedAt @map("update_at")

  @@map("hardware")
}

/// ประวัติว่ากล่องไหนถูกติดตั้งที่จุดไหน "ช่วงเวลาใด" — เป็น source of truth ของการสลับเครื่อง
///
/// ช่วงเวลาคือหัวใจ: กล่องที่ซ่อมเสร็จแล้วนำไปใช้ที่จุดอื่นจะมี assignment ใหม่คนละช่วง
/// ทำให้ log เก่าของมันไม่ถูกนับเป็นของจุดติดตั้งใหม่ (partial unique index กันช่วงซ้อนกัน
/// ดูใน migration — Prisma ประกาศ partial index ไม่ได้)
model DeviceAssignments {
  id        String    @id @default(uuid()) @map("id")
  deviceId  String    @map("device_id")
  serial    String    @map("serial")
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  reason    String?   @map("reason")
  device    Devices   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  hardware  Hardware  @relation(fields: [serial], references: [serial], onDelete: Cascade)
  createAt  DateTime  @default(now()) @map("create_at")
  updateAt  DateTime  @default(now()) @updatedAt @map("update_at")

  @@index([serial, startedAt])
  @@index([deviceId, startedAt])
  @@map("device_assignments")
}

/// ตั้งค่า threshold/แจ้งเตือนต่อ probe — ยกมาจาก smtrack-device
/// ผูกกับ "จุดติดตั้ง" (Devices.id) ไม่ใช่กล่อง เพราะเป็นค่าที่ตั้งตามหน้างาน
/// เมื่อสลับกล่องใหม่เข้าจุดเดิม ค่าเหล่านี้จึงกลับมาใช้ได้ทันทีโดยไม่ต้องตั้งใหม่
///
/// `channel` คือช่องที่อุปกรณ์อ้างถึงตัวเองใน payload (`LogDays.probe`) — เป็น business key
/// คู่กับ `deviceId` จึงต้อง unique เพื่อให้ resolve `probeId` ตอน ingest ได้แบบ deterministic
model Probes {
  id                    String   @id @default(uuid()) @map("id")
  deviceId              String   @map("device_id")
  name                  String?  @default("P1") @map("name")
  type                  String?  @default("SHT-31") @map("type")
  channel               String   @default("1") @map("channel")
  tempMin               Float    @default(0.00) @map("temp_min")
  tempMax               Float    @default(0.00) @map("temp_max")
  humiMin               Float    @default(0.00) @map("humi_min")
  humiMax               Float    @default(0.00) @map("humi_max")
  tempAdj               Float    @default(0.00) @map("temp_adj")
  humiAdj               Float    @default(0.00) @map("humi_adj")
  stampTime             String?  @default("5") @map("stamp_time")
  doorQty               Int      @default(1) @map("door_qty")
  position              String?  @map("position")
  muteAlarmDuration     String?  @map("mute_alarm_duration")
  doorSound             Boolean  @default(true) @map("door_sound")
  doorAlarmTime         String?  @map("door_alarm_time")
  muteDoorAlarmDuration String?  @map("mute_door_alarm_duration")
  notiDelay             Int      @default(0) @map("noti_delay")
  notiToNormal          Boolean  @default(true) @map("noti_to_normal")
  notiMobile            Boolean  @default(true) @map("noti_mobile")
  notiRepeat            Int      @default(1) @map("noti_repeat")
  firstDay              Day      @default(OFF) @map("first_day")
  secondDay             Day      @default(OFF) @map("second_day")
  thirdDay              Day      @default(OFF) @map("third_day")
  firstTime             String?  @default("0000") @map("first_time")
  secondTime            String?  @default("0000") @map("second_time")
  thirdTime             String?  @default("0000") @map("third_time")
  device                Devices  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  log                   LogDays[]
  notification          Notifications[]
  createAt              DateTime @default(now()) @map("create_at")
  updateAt              DateTime @default(now()) @updatedAt @map("update_at")

  // แทน @@index([deviceId]) เดิม — เป็น prefix ของ unique นี้อยู่แล้ว จึงซ้ำซ้อน
  @@unique([deviceId, channel])
  @@map("probes")
}

/// network/email config ของจุดติดตั้ง (one-to-one กับ Devices) — ยกมาจาก smtrack-device
/// ผูกกับ Devices.id ด้วยเหตุผลเดียวกับ Probes: สลับกล่องแล้ว config เดิมต้องกลับมา
model Configs {
  id         String   @id @default(uuid()) @map("id")
  deviceId   String   @unique @map("device_id")
  dhcp       Boolean  @default(true) @map("dhcp")
  ip         String?  @map("ip")
  mac        String?  @map("mac")
  subnet     String?  @map("subnet")
  gateway    String?  @map("gateway")
  dns        String?  @map("dns")
  dhcpEth    Boolean? @default(true) @map("dhcp_eth")
  ipEth      String?  @map("ip_eth")
  macEth     String?  @map("mac_eth")
  subnetEth  String?  @map("subnet_eth")
  gatewayEth String?  @map("gateway_eth")
  dnsEth     String?  @map("dns_eth")
  ssid       String?  @default("RDE3_2.4GHz") @map("ssid")
  password   String?  @map("password")
  simSP      String?  @map("sim_sp")
  email1     String?  @map("email1")
  email2     String?  @map("email2")
  email3     String?  @map("email3")
  hardReset  String?  @default("0200") @map("hard_reset")
  device     Devices  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  createAt   DateTime @default(now()) @map("create_at")
  updateAt   DateTime @default(now()) @updatedAt @map("update_at")

  @@map("configs")
}

/// ประวัติแจ้งซ่อม — ผูกกับ "กล่อง" (Hardware.serial) ไม่ใช่จุดติดตั้ง
/// กล่องที่พังถูกส่งไปซ่อมแล้วนำไปใช้ที่จุดอื่น ประวัติซ่อมต้องตามกล่องไปด้วย
model Repairs {
  id             String   @id @default(uuid()) @map("id")
  seq            Int      @unique @default(autoincrement()) @map("seq")
  serial         String   @map("serial")
  devName        String?  @map("dev_name")
  info           String?  @map("info")
  info1          String?  @map("info1")
  info2          String?  @map("info2")
  address        String?  @map("address")
  ward           String?  @map("ward")
  detail         String?  @map("detail")
  phone          String?  @map("phone")
  status         String?  @map("status")
  warrantyStatus String?  @map("warranty_status")
  remark         String?  @map("remark")
  hardware       Hardware @relation(fields: [serial], references: [serial], onDelete: Cascade)
  createAt       DateTime @default(now()) @map("create_at")
  updateAt       DateTime @default(now()) @updatedAt @map("update_at")

  @@index([serial])
  @@map("repairs")
}

/// ข้อมูลประกัน — ผูกกับกล่องด้วยเหตุผลเดียวกับ Repairs (ประกันเป็นของตัวเครื่อง)
model Warranties {
  id              String   @id @default(uuid()) @map("id")
  serial          String   @map("serial")
  devName         String?  @map("dev_name")
  product         String?  @map("product")
  model           String?  @map("model")
  installDate     String?  @map("install_date")
  customerName    String?  @map("customer_name")
  customerAddress String?  @map("customer_address")
  saleDepartment  String?  @map("sale_department")
  invoice         String?  @map("invoice")
  expire          DateTime @default(now()) @map("expire")
  status          Boolean  @default(true) @map("status")
  note            String?  @map("note")
  hardware        Hardware @relation(fields: [serial], references: [serial], onDelete: Cascade)
  createAt        DateTime @default(now()) @map("create_at")
  updateAt        DateTime @default(now()) @updatedAt @map("update_at")

  @@index([serial])
  @@map("warranties")
}

// ตารางเวลาแจ้งเตือนรายวันของ Probes
enum Day {
  OFF
  ALL
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model LogDays {
  id              String   @id @default(uuid()) @map("id")
  serial          String   @map("serial")
  temp            Float    @default(0.00) @map("temp")
  tempDisplay     Float    @default(0.00) @map("temp_display")
  humidity        Float    @default(0.00) @map("humidity")
  humidityDisplay Float    @default(0.00) @map("humidity_display")
  sendTime        DateTime @default(now()) @map("send_time")
  plug            Boolean  @default(false) @map("plug")
  door1           Boolean  @default(false) @map("door1")
  door2           Boolean  @default(false) @map("door2")
  door3           Boolean  @default(false) @map("door3")
  internet        Boolean  @default(false) @map("internet")
  /// channel ดิบตามที่อุปกรณ์ส่งมา — คงไว้เป็น denormalized fallback สำหรับแถวที่ resolve
  /// `probeId` ไม่ได้ (กล่องยังไม่ถูกติดตั้ง) และเป็นตัวตั้งต้นของการ backfill
  probe           String   @default("1") @map("probe")
  battery         Int      @default(0) @map("battery")
  tempInternal    Float?   @default(0.00) @map("temp_internal")
  extMemory       Boolean  @default(false) @map("ext_memory")
  deviceId        String?  @map("device_id")
  /// probe ที่ log แถวนี้มาจาก — nullable ด้วยเหตุผลเดียวกับ `deviceId`: กล่องที่ยังไม่ถูก
  /// ติดตั้งที่จุดไหน (เพิ่งซ่อมเสร็จ/อยู่ในคลัง) ไม่มี Probes ให้ผูก แต่ยังต้องเก็บ log ได้
  probeId         String?  @map("probe_id")
  hardware        Hardware @relation(fields: [serial], references: [serial])
  device          Devices? @relation(fields: [deviceId], references: [id])
  probeRef        Probes?  @relation(fields: [probeId], references: [id], onDelete: SetNull)
  createAt        DateTime @default(now()) @map("create_at")
  updateAt        DateTime @default(now()) @updatedAt @map("update_at")

  /// กันแถวซ้ำเมื่อ log เดียวกันเข้ามาซ้ำ (MQTT QoS 1 redeliver, legacy sync + backfill ทับช่วงกัน)
  /// ต้องมี sendTime อยู่ใน key เพราะ TimescaleDB บังคับให้ unique index ของ hypertable รวม partition column
  @@unique([serial, probe, sendTime], map: "log_days_serial_probe_send_time_key")
  @@index([serial, sendTime])
  @@index([deviceId, sendTime])
  @@index([deviceId, probeId, sendTime])
  @@map("log_days")
}

// เป็น TimescaleDB hypertable บน createAt แล้ว (PK จริงใน DB เป็น composite (id, create_at)
// แต่ schema ยังคง @id เดี่ยวไว้ตาม pattern เดียวกับ LogDays เพราะ id ยัง unique พอในทางปฏิบัติ)
model Notifications {
  id           String   @id @default(uuid()) @map("id")
  serial       String   @map("serial")
  message      String   @map("message")
  detail       String   @map("detail")
  status       Boolean  @default(false) @map("status")
  deliveredSse Boolean  @default(false) @map("delivered_sse") // ส่งผ่าน SSE สำเร็จหรือยัง
  deliveredFcm Boolean  @default(false) @map("delivered_fcm") // ส่งผ่าน FCM สำเร็จหรือยัง
  /// ผู้ใช้ (ฝั่ง dashboard) อ่าน/รับทราบการแจ้งเตือนนี้แล้วหรือยัง — คนละความหมายกับ deliveredSse/Fcm
  /// ที่บอกแค่ว่าส่งออกไปสำเร็จหรือไม่ ไม่ได้บอกว่ามีคนเห็นแล้ว
  isRead       Boolean  @default(false) @map("is_read")
  readAt       DateTime? @map("read_at")
  /// หมวดแจ้งเตือน แยกจาก message string เพื่อ query/filter ได้โดยไม่ต้อง parse ซ้ำทุกครั้ง
  /// คำนวณตอน create() ด้วย notification-classifier.util.ts (TEMP|DOOR|INTERNET|PLUG|SDCARD|REPORT|OTHER)
  category     String   @default("OTHER") @map("category")
  /// ระดับความสำคัญ คำนวณจาก classifier เดียวกัน (critical|warning|info)
  severity     String   @default("info") @map("severity")
  deviceId     String?  @map("device_id")
  /// probe ที่เป็นต้นเหตุของการแจ้งเตือน — 1 device มีหลาย probe การแจ้งเตือนอุณหภูมิเกินช่วง
  /// จึงต้องบอกได้ว่า probe ไหน nullable ด้วยเหตุผลเดียวกับ LogDays.probeId
  probeId      String?  @map("probe_id")
  /// channel ดิบตามที่อุปกรณ์ส่งมา — fallback เมื่อ resolve probeId ไม่ได้
  probe        String?  @map("probe")
  hardware     Hardware @relation(fields: [serial], references: [serial])
  device       Devices? @relation(fields: [deviceId], references: [id])
  probeRef     Probes?  @relation(fields: [probeId], references: [id], onDelete: SetNull)
  createAt     DateTime @default(now()) @map("create_at")
  updateAt     DateTime @default(now()) @updatedAt @map("update_at")

  @@index([serial, createAt])
  @@index([deviceId, createAt])
  @@index([probeId, createAt])
  @@index([deviceId, isRead])
  @@map("notifications")
}

// ปลายทาง restore ของ LogDays เดือนที่ถูก archive ไป object storage แล้ว
// ไม่มี relation ไปยัง Devices เพราะข้อมูลต้องอยู่ต่อได้แม้ device ถูกลบไปแล้ว
model LogDayArchive {
  id              String   @id @default(uuid()) @map("id")
  serial          String   @map("serial")
  temp            Float    @default(0.00) @map("temp")
  tempDisplay     Float    @default(0.00) @map("temp_display")
  humidity        Float    @default(0.00) @map("humidity")
  humidityDisplay Float    @default(0.00) @map("humidity_display")
  sendTime        DateTime @map("send_time")
  plug            Boolean  @default(false) @map("plug")
  door1           Boolean  @default(false) @map("door1")
  door2           Boolean  @default(false) @map("door2")
  door3           Boolean  @default(false) @map("door3")
  internet        Boolean  @default(false) @map("internet")
  probe           String   @default("1") @map("probe")
  battery         Int      @default(0) @map("battery")
  tempInternal    Float?   @default(0.00) @map("temp_internal")
  extMemory       Boolean  @default(false) @map("ext_memory")
  // ไม่มี FK ไป Devices/Probes ด้วยเหตุผลเดียวกับ serial — ข้อมูล archive ต้องอยู่ต่อได้แม้
  // device/probe ถูกลบ (จึงเป็นแค่ String เปล่า ไม่ประกาศ relation)
  deviceId        String?  @map("device_id")
  probeId         String?  @map("probe_id")
  createAt        DateTime @default(now()) @map("create_at")
  updateAt        DateTime @default(now()) @updatedAt @map("update_at")

  @@index([deviceId, sendTime])
  @@index([deviceId, probeId, sendTime])
  @@map("log_day_archive")
}

/// audit ของการเพิ่ม/แก้ไข/สลับข้อมูลอุปกรณ์ — อายุเท่า telemetry (6 เดือน) ผ่าน TimescaleDB
/// retention policy เดียวกับ LogDays ไม่ผูก FK กับ Devices เพื่อให้แถว audit อยู่ต่อได้แม้
/// จุดติดตั้งถูกลบไปในอนาคต
model DeviceAudit {
  id         String   @id @default(uuid()) @map("id")
  deviceId   String   @map("device_id")
  staticName String   @map("static_name")
  action     String   @map("action")
  actorId    String?  @map("actor_id")
  actorName  String?  @map("actor_name")
  actorRole  String?  @map("actor_role")
  snapshot   Json     @map("snapshot")
  createAt   DateTime @default(now()) @map("create_at")

  @@index([deviceId, createAt])
  @@index([actorId, createAt])
  @@map("device_audit")
}

/// audit log รวมทุก action ของ user ข้าม entity (device/probe/config/repair) — ต่างจาก DeviceAudit
/// ที่ query หลักคือ deviceId, ตัวนี้ query หลักคือ actorId (ไม่มี model Users เก็บผู้ใช้เองในระบบนี้
/// actor มาจาก JWT payload เท่านั้น) อายุ/retention เดียวกับ DeviceAudit (6 เดือน, TimescaleDB hypertable)
/// ไม่ผูก FK กับ entity ใด ๆ ด้วยเหตุผลเดียวกับ DeviceAudit — แถว audit ต้องอยู่ต่อได้แม้ entity ถูกลบ
model UserAudit {
  id         String   @id @default(uuid()) @map("id")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String   @map("action")
  actorId    String?  @map("actor_id")
  actorName  String?  @map("actor_name")
  actorRole  String?  @map("actor_role")
  snapshot   Json     @map("snapshot")
  createAt   DateTime @default(now()) @map("create_at")

  @@index([actorId, createAt])
  @@index([entityType, entityId, createAt])
  @@map("user_audit")
}

/// ไฟล์ firmware แต่ละเวอร์ชั่นสำหรับให้อุปกรณ์ IoT ดาวน์โหลด (OTA) — global list ไม่ผูกกับ
/// device/hardware รุ่นใดรุ่นหนึ่ง เพราะ schema ปัจจุบันไม่มี field รุ่น/model ของอุปกรณ์
/// ไฟล์จริงเก็บใน S3 แยก bucket (firmware.s3), ตารางนี้เก็บแค่ metadata + object key
model Firmwares {
  id          String   @id @default(uuid()) @map("id")
  version     String   @unique @map("version")
  name        String   @map("name")
  description String?  @map("description")
  fileKey     String   @map("file_key")
  fileName    String   @map("file_name")
  fileSize    Int      @map("file_size")
  checksum    String?  @map("checksum")
  createAt    DateTime @default(now()) @map("create_at")
  updateAt    DateTime @default(now()) @updatedAt @map("update_at")

  @@map("firmwares")
}

// audit ของการ export LogDays รายเดือนขึ้น object storage (กัน export ซ้ำ)
model ArchiveExport {
  /// ตารางต้นทางของไฟล์ archive: log_days | notifications | device_audit | user_audit
  /// (แถวเดิมก่อนมีคอลัมน์นี้ทั้งหมดคือ log_days จึงใช้เป็นค่า default)
  sourceTable String   @default("log_days") @map("source_table")
  month       DateTime @db.Date @map("month")
  rowCount    BigInt   @map("row_count")
  objectKey   String   @map("object_key")
  sha256      String   @map("sha256")
  exportedAt  DateTime @default(now()) @map("exported_at")

  @@id([sourceTable, month])
  @@map("archive_export")
}

// audit ของการ restore LogDayArchive กลับมาให้ query (กัน restore ซ้ำ / ใช้ทำ UI จัดการ)
model ArchiveRestore {
  month      DateTime @id @db.Date @map("month")
  rowCount   BigInt   @map("row_count")
  objectKey  String   @map("object_key")
  restoredAt DateTime @default(now()) @map("restored_at")

  @@map("archive_restore")
}

/// ข้อมูลที่ on-demand restore กลับเข้ามาชั่วคราวต่อ (ตาราง, install point, เดือน)
/// ใช้เป็นทั้งล็อกกัน restore ซ้อนข้าม replica (unique key) และตัวนับ TTL (lastReadAt/expiresAt)
/// ดู ADR-0005 และคำว่า "Restored window" ใน CONTEXT.md
model RestoredWindow {
  id          String    @id @default(uuid()) @map("id")
  sourceTable String    @map("source_table")
  deviceId    String    @map("device_id")
  month       DateTime  @db.Date @map("month")
  /// pending | running | done | failed
  status      String    @default("pending") @map("status")
  rowCount    BigInt    @default(0) @map("row_count")
  error       String?   @map("error")
  requestedAt DateTime  @default(now()) @map("requested_at")
  restoredAt  DateTime? @map("restored_at")
  lastReadAt  DateTime  @default(now()) @map("last_read_at")
  expiresAt   DateTime  @map("expires_at")

  @@unique([sourceTable, deviceId, month])
  @@index([status, expiresAt])
  @@map("restored_window")
}

/// บันทึกทุกครั้งที่ CronJob ของ archive รัน — ดูย้อนหลังได้โดยไม่พึ่ง history ของ k8s Job
/// ดู ADR-0006
model ArchiveJobRun {
  id          String    @id @default(uuid()) @map("id")
  /// export-and-drop | cleanup-restored
  job         String    @map("job")
  sourceTable String?   @map("source_table")
  month       DateTime? @db.Date @map("month")
  /// running | succeeded | failed | skipped
  status      String    @default("running") @map("status")
  rowCount    BigInt?   @map("row_count")
  sha256      String?   @map("sha256")
  error       String?   @map("error")
  startedAt   DateTime  @default(now()) @map("started_at")
  finishedAt  DateTime? @map("finished_at")

  @@index([job, startedAt])
  @@index([status, startedAt])
  @@map("archive_job_run")
}

/// credential ของ Partner (third-party ภายนอก) — เก็บแค่ hash ของ key จริง (SHA-256)
/// plaintext โชว์ครั้งเดียวตอนสร้างเท่านั้น ดู ADR-0002 เรื่อง Box serial, ADR-0003 เรื่องการ scope
/// เป็นกลุ่ม (แทน per-serial allowlist) และ ADR-0004 ที่เปลี่ยนจาก ward เป็น tenant
model PartnerApiKeys {
  id          String                  @id @default(uuid()) @map("id")
  name        String                  @map("name")
  keyHash     String                  @unique @map("key_hash")
  /// ไม่ sensitive — เก็บไว้แค่ให้แอดมิน list แล้วแยกออกจากกันได้โดยไม่ต้องเก็บ/โชว์ key เต็ม
  keyPrefix   String                  @map("key_prefix")
  revokedAt   DateTime?               @map("revoked_at")
  tenants     PartnerApiKeyTenants[]
  legacyWards PartnerApiKeyDepartmentsLegacy[]
  requestLogs PartnerApiRequestLogs[]
  createAt    DateTime                @default(now()) @map("create_at")
  updateAt    DateTime                @default(now()) @updatedAt @map("update_at")

  @@map("partner_api_keys")
}

/// allowlist ของ key แต่ละใบ — scope ด้วย tenant (ไม่ใช่ serial รายตัว) ดู ADR-0003/0004
model PartnerApiKeyTenants {
  id       String         @id @default(uuid()) @map("id")
  keyId    String         @map("key_id")
  tenantId String         @map("tenant_id")
  key      PartnerApiKeys @relation(fields: [keyId], references: [id], onDelete: Cascade)
  createAt DateTime       @default(now()) @map("create_at")

  @@unique([keyId, tenantId])
  @@index([keyId])
  @@map("partner_api_key_tenants")
}

/// allowlist แบบ ward เดิม — เก็บไว้ให้ scripts/backfill-tenant แปลงเป็น PartnerApiKeyTenants เท่านั้น
/// แอปไม่อ่าน/เขียนตารางนี้ ลบทิ้งด้วย migration ถัดไปหลัง backfill เสร็จ (ADR-0004)
model PartnerApiKeyDepartmentsLegacy {
  id           String         @id @default(uuid()) @map("id")
  keyId        String         @map("key_id")
  departmentId String         @map("department_id")
  key          PartnerApiKeys @relation(fields: [keyId], references: [id], onDelete: Cascade)
  createAt     DateTime       @default(now()) @map("create_at")

  @@unique([keyId, departmentId])
  @@index([keyId])
  @@map("partner_api_key_departments_legacy")
}

/// audit log ของทุก request ที่เข้า Partner API — เก็บไว้สำหรับ billing/investigation
/// retention 90 วัน ดูแลโดย cron ใน PartnerApiKeyCleanupService (เหมือน backup module)
model PartnerApiRequestLogs {
  id           String         @id @default(uuid()) @map("id")
  keyId        String         @map("key_id")
  /// เติมเฉพาะ RPC ที่ระบุ serial — ListDevicesByTenant เติม tenantId ด้านล่างแทน
  serial       String?        @map("serial")
  /// เติมเฉพาะ ListDevicesByTenant
  tenantId     String?        @map("tenant_id")
  /// ward ของ log ก่อนเปลี่ยนเป็น tenant (ADR-0004) — ประวัติเท่านั้น ไม่มีการเขียนใหม่
  legacyWard   String?        @map("legacy_ward")
  /// path เดิมของ REST — ตอนนี้เก็บชื่อ RPC method (เช่น partner.PartnerService/GetDeviceSnapshot)
  path         String         @map("path")
  statusCode   Int            @map("status_code")
  key          PartnerApiKeys @relation(fields: [keyId], references: [id], onDelete: Cascade)
  createAt     DateTime       @default(now()) @map("create_at")

  @@index([keyId, createAt])
  @@map("partner_api_request_logs")
}

/// Legacy sync (ADR-0007) — ชั่วคราวจนถึง cutover แล้ว drop ทิ้งทั้งตาราง
/// map id ของแถวในระบบเดิม → id ของแถวใน v2 และจำ `updateAt` ล่าสุดที่ apply แล้ว (last-writer-wins)
/// แยกเป็นตารางเดียวแทนการเพิ่มคอลัมน์ legacy_* ใน domain table ทุกตัว เพื่อให้ลบทิ้งได้ในครั้งเดียว
model LegacySyncMap {
  /// device | probe | config | repair | warranty
  entity          String   @map("entity")
  legacyId        String   @map("legacy_id")
  targetId        String   @map("target_id")
  legacyUpdatedAt DateTime @map("legacy_updated_at")
  /// แถว legacy ที่ถูกแทนแล้ว (เช่น device row เก่าหลัง Swap) — snapshot ที่มาทีหลังของแถวนี้จะถูกข้าม
  retired         Boolean  @default(false) @map("retired")
  createAt        DateTime @default(now()) @map("create_at")
  updateAt        DateTime @default(now()) @updatedAt @map("update_at")

  @@id([entity, legacyId])
  @@index([entity, targetId])
  @@map("legacy_sync_map")
}
